{
  "name": "tile-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small, offline tile-map editor with original terrain tiles.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "test:demo": "playwright test",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "^17.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
